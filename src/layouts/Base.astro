---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO, ruta } from '../lib/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** La portada termina bajo el agua: el pie no dibuja su propia ola. */
  portada?: boolean;
}

const { titulo, descripcion = SITIO.descripcion, portada = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.titulo}` : SITIO.titulo;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/png" href={ruta('/favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f3efe4" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.titulo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body class:list={{ portada }}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
