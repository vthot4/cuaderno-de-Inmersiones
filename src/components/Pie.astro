---
import { NAVEGACION, SITIO, ruta } from '../lib/sitio';
---

<footer class="pie">
  <div class="contenedor interior">
    <div>
      <p class="titulo">{SITIO.titulo}</p>
      <p class="aviso">
        Esto es un cuaderno personal, no una guía. Cada inmersión se planifica con el parte del día y con quien
        conoce el punto.
      </p>
    </div>
    <ul>
      {
        NAVEGACION.map(({ camino, texto }) => (
          <li>
            <a href={ruta(camino)}>{texto}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .pie {
    padding-block: 5rem 3rem;
    background: var(--mar-5);
    color: var(--espuma);
    -webkit-mask:
      var(--ola) 0 0 / 30rem 1.5rem repeat-x,
      linear-gradient(#000 0 0) 0 1.45rem / 100% calc(100% - 1.45rem) no-repeat;
    mask:
      var(--ola) 0 0 / 30rem 1.5rem repeat-x,
      linear-gradient(#000 0 0) 0 1.45rem / 100% calc(100% - 1.45rem) no-repeat;
  }

  :global(body.portada) .pie {
    -webkit-mask: none;
    mask: none;
  }

  .interior {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 4rem;
  }

  .titulo {
    font: 600 1.35rem var(--f-titulo);
  }

  .aviso {
    max-width: 30rem;
    margin-top: 0.6rem;
    font-size: 1rem;
    opacity: 0.72;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font: 0.8125rem var(--f-dato);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--laminaria);
    text-underline-offset: 0.3em;
  }
</style>
