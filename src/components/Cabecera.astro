---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { NAVEGACION, SITIO, ruta } from '../lib/sitio';

const actual = Astro.url.pathname;
---

<header class="cabecera contenedor">
  <a class="marca" href={ruta('/')}>
    <Image src={logo} alt="" width={84} loading="eager" decoding="sync" />
    {SITIO.titulo}
  </a>
  <nav aria-label="Secciones">
    <ul>
      {
        NAVEGACION.map(({ camino, texto }) => (
          <li>
            <a href={ruta(camino)} aria-current={actual.startsWith(ruta(camino)) ? 'page' : undefined}>
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.4rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font: 600 1.2rem/1 var(--f-titulo);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .marca img {
    width: auto;
    height: 3rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 3vw, 1.6rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    font: 0.8125rem var(--f-dato);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.3rem;
    border-bottom: 1.5px solid transparent;
  }

  nav a:hover,
  nav a[aria-current] {
    border-bottom-color: var(--ocle);
  }
</style>
