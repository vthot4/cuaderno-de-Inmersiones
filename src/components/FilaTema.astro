---
import type { CollectionEntry } from 'astro:content';
import { fecha, fechaISO, ruta } from '../lib/sitio';

interface Props {
  tema: CollectionEntry<'temas'>;
}

const { tema } = Astro.props;
---

<a class="fila" href={ruta(`/temas/${tema.id}/`)}>
  <time class="dato" datetime={fechaISO(tema.data.fecha)}>{fecha(tema.data.fecha)}</time>
  <span class="texto">
    <span class="titulo">{tema.data.titulo}</span>
    <span class="resumen">{tema.data.resumen}</span>
  </span>
  <span class="flecha" aria-hidden="true">→</span>
</a>

<style>
  .fila {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    text-decoration: none;
  }

  .dato {
    grid-column: 1 / -1;
    opacity: 0.75;
  }

  .texto {
    display: grid;
    gap: 0.3rem;
  }

  .titulo {
    font: 500 clamp(1.5rem, 3.5vw, 2.1rem) / 1.1 var(--f-titulo);
    letter-spacing: -0.015em;
  }

  .resumen {
    opacity: 0.78;
  }

  .flecha {
    font: 1.5rem var(--f-dato);
    transition: translate 0.2s ease;
  }

  .fila:hover .flecha {
    translate: 0.4rem 0;
  }

  @media (min-width: 48rem) {
    .fila {
      grid-template-columns: 9rem 1fr auto;
    }

    .dato {
      grid-column: auto;
    }
  }
</style>
