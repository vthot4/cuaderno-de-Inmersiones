---
import 'leaflet/dist/leaflet.css';

interface Punto {
  nombre: string;
  lat: number;
  lon: number;
  /** Enlace a la ficha de la zona, para el globo del marcador. */
  href?: string;
}

interface Props {
  puntos: Punto[];
  etiqueta: string;
  alto?: string;
}

const { puntos, etiqueta, alto = '26rem' } = Astro.props;
---

<div class="mapa" role="region" aria-label={etiqueta} data-puntos={JSON.stringify(puntos)} style={`height:${alto}`}>
</div>

<script>
  import L from 'leaflet';

  interface Punto {
    nombre: string;
    lat: number;
    lon: number;
    href?: string;
  }

  for (const lienzo of document.querySelectorAll<HTMLElement>('.mapa')) {
    const puntos: Punto[] = JSON.parse(lienzo.dataset.puntos ?? '[]');
    const mapa = L.map(lienzo, { scrollWheelZoom: false });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 17,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mapa);

    const boya = L.divIcon({ className: 'boya', iconSize: [20, 20] });
    const marcadores = puntos.map((punto) => {
      const globo = document.createElement(punto.href ? 'a' : 'span');
      globo.textContent = punto.nombre;
      if (punto.href) globo.setAttribute('href', punto.href);
      return L.marker([punto.lat, punto.lon], { icon: boya, title: punto.nombre }).bindPopup(globo).addTo(mapa);
    });

    if (puntos.length > 1) {
      mapa.fitBounds(L.featureGroup(marcadores).getBounds().pad(0.3), { maxZoom: 12 });
    } else if (puntos.length === 1) {
      mapa.setView([puntos[0].lat, puntos[0].lon], 12);
    } else {
      // Sin zonas todavía: la costa cantábrica entera.
      mapa.setView([43.5, -5], 7);
    }
  }
</script>

<style is:global>
  .mapa {
    border: 1px solid var(--linea);
    border-radius: 3px;
    background: var(--espuma);
    font-family: var(--f-dato);
    /* Por debajo del enlace «Saltar al contenido». */
    isolation: isolate;
  }

  /* Tono de carta náutica vieja sobre las teselas. */
  .mapa .leaflet-tile-pane {
    filter: sepia(0.28) saturate(0.75) hue-rotate(-8deg);
  }

  .boya {
    border: 3px solid var(--espuma);
    border-radius: 50%;
    background: var(--ocle);
    box-shadow: 0 2px 6px rgb(4 22 28 / 0.5);
  }

  .mapa .leaflet-popup-content-wrapper {
    border-radius: 3px;
    background: var(--espuma);
    color: var(--tinta);
  }

  .mapa .leaflet-popup-tip {
    background: var(--espuma);
  }

  .mapa .leaflet-popup-content {
    font: 0.875rem var(--f-dato);
  }

  .mapa .leaflet-popup-content a {
    color: var(--ocle);
  }
</style>
